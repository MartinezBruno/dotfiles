        "context_servers": {},
        "agent_servers": {},
        "slash_commands": {},
        "snippets": null,
        "capabilities": []
      },
      "dev": false
    },
    "html": {
      "manifest": {
        "id": "html",
        "name": "HTML",
        "version": "0.3.0",
        "schema_version": 1,
        "description": "HTML support.",
        "repository": "https://github.com/zed-industries/zed",
        "authors": [
          "Isaac Clayton <slightknack@gmail.com>"
        ],
        "lib": {
          "kind": "Rust",
          "version": "0.7.0"
        },
        "themes": [],
        "icon_themes": [],
        "languages": [
          "languages/html"
        ],
        "grammars": {
          "html": {
            "repository": "https://github.com/tree-sitter/tree-sitter-html",
