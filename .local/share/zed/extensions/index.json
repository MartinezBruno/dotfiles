  "themes": {
    "Claude Code Inspired Dark": {
      "extension": "claude-code-inspired-dark",
      "path": "themes/claude-code-inspired-dark.json"
    }
  },
  "icon_themes": {
    "Catppuccin Frappé": {
      "extension": "catppuccin-icons",
      "path": "icon_themes/catppuccin-icons.json"
    },
    "Catppuccin Latte": {
      "extension": "catppuccin-icons",
      "path": "icon_themes/catppuccin-icons.json"
    },
    "Catppuccin Macchiato": {
      "extension": "catppuccin-icons",
      "path": "icon_themes/catppuccin-icons.json"
    },
    "Catppuccin Mocha": {
      "extension": "catppuccin-icons",
      "path": "icon_themes/catppuccin-icons.json"
    }
  },
  "languages": {
    "Git Attributes": {
      "extension": "git-firefly",
      "path": "languages/gitattributes",
      "matcher": {
        "path_suffixes": [
          "gitattributes",
          ".gitattributes"
        ],
        "first_line_pattern": null
      },
      "hidden": false,
      "grammar": "gitattributes"
    },
    "Git Config": {
      "extension": "git-firefly",
      "path": "languages/gitconfig",
      "matcher": {
        "path_suffixes": [
          "config.worktree",
          ".gitconfig",
          ".gitmodules",
          ".lfsconfig"
        ],
        "first_line_pattern": null
      },
      "hidden": false,
      "grammar": "git_config"
    },
    "Git Ignore": {
      "extension": "git-firefly",
      "path": "languages/gitignore",
      "matcher": {
        "path_suffixes": [
          ".containerignore",
          ".cursorignore",
          ".dockerignore",
          ".eslintignore",
          ".fdignore",
          ".gitignore",
          ".git-blame-ignore-revs",
          ".ignore",
          ".npmignore",
          ".prettierignore",
          ".rgignore",
          ".vscodeignore"
        ],
        "first_line_pattern": null
      },
      "hidden": false,
      "grammar": "gitignore"
    },
    "Git Rebase": {
      "extension": "git-firefly",
      "path": "languages/gitrebase",
      "matcher": {
        "path_suffixes": [
          "git-rebase-todo"
        ],
        "first_line_pattern": null
      },
      "hidden": false,
      "grammar": "git_rebase"
    },
    "HTML": {
      "extension": "html",
      "path": "languages/html",
      "matcher": {
        "path_suffixes": [
          "html",
          "htm",
          "shtml"
        ],
        "first_line_pattern": null
      },
      "hidden": false,
      "grammar": "html"
    },
    "Liquid": {
      "extension": "liquid",
      "path": "languages/liquid",
      "matcher": {
        "path_suffixes": [
          "liquid"
        ],
        "first_line_pattern": null
      },
      "hidden": false,
      "grammar": "liquid"
    }
  }
}